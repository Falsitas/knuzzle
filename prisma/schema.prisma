// -----------------------------------------------------------------------------
// Prisma Generator
// -----------------------------------------------------------------------------
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

// -----------------------------------------------------------------------------
// Database Configuration
// Connection URL is configured in prisma.config.ts
// -----------------------------------------------------------------------------
datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

/// User permission
enum Role {
  ADMIN
  MEMBER
}

/// User's primary session and vote session
enum Session {
  VOCAL
  GUITAR
  KEYBOARD
  BASS
  DRUM
}

/// Administrator's final decision for a song
enum SongStatus {
  PENDING
  SELECTED
  REJECTED
}

enum AuthProvider {
  KAKAO
}

// -----------------------------------------------------------------------------
// User
// A registered member of the band.
//
// Relations
// - createdSongs : Songs this user registered
// - vocalSongs   : Songs assigned to this user as vocalist
// - votes        : Votes cast by this user
// -----------------------------------------------------------------------------
model User {
  id             Int    @id @default(autoincrement())
  email          String? @unique
  provider       AuthProvider
  providerId     String   @unique
  nickname       String

  role           Role    @default(MEMBER)
  primarySession Session?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdSongs   Song[] @relation("SongCreator")
  vocalSongs     Song[] @relation("SongVocal")
  votes          Vote[]
}

// -----------------------------------------------------------------------------
// Song
// A candidate song for the upcoming performance.
//
// createdBy : User who registered the song.
// vocal     : User assigned as vocalist.
// -----------------------------------------------------------------------------
model Song {
  id           Int     @id @default(autoincrement())
  title        String
  artist       String
  referenceUrl String?
  memo         String?

  status SongStatus @default(PENDING)

  createdById Int
  vocalId     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User @relation("SongCreator", fields: [createdById], references: [id])
  vocal     User @relation("SongVocal", fields: [vocalId], references: [id])

  requiredParts SongRequiredPart[]
  
  votes Vote[]
}

// -----------------------------------------------------------------------------
// SongRequiredPart
// Required part of the song.
//
// session should be unigue to prevent double guitar for example.
// count shows how many session will be needed for same instrument (guitar, keyboard)
// -----------------------------------------------------------------------------
model SongRequiredPart {
  id Int @id @default(autoincrement())

  songId Int
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  session Session
  count Int

  @@unique([songId, session])
}

// -----------------------------------------------------------------------------
// Vote
// One user's vote for one song.
//
// Rules
// - One user can vote only once per song.
// - LIKE votes must include session information.
// - line is used for instruments requiring multiple positions
//   (e.g. Guitar 1, Guitar 2).
// -----------------------------------------------------------------------------
model Vote {
  id Int @id @default(autoincrement())

  userId Int
  songId Int

  rating Int  // 1~5

  session Session?
  /// Session-specific detail.
  /// Examples:
  /// - Guitar: "1", "2"
  /// - Keyboard: "Piano", "Pad"
  /// - Drum/Bass/Vocal: null
  sessionDetail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  song Song @relation(fields: [songId], references: [id])

  @@unique([userId, songId])
}
